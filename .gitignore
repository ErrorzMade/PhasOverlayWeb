# Build / dependency output
node_modules/
dist/
build/
.cache/
worker/

# Environment and secrets
.env
.env.*
*.pem
*.key

# Editors
.vscode/
.idea/
*.code-workspace

# OS cruft
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Logs and temp files
*.log
npm-debug.log*
*.tmp
*.bak
*.orig
*~

# Source images kept locally, not shipped
assets/**/*.psd
assets/**/*.xcf
assets/screenshots/*.png

# Local notes. Working notes and design records stay on disk: the published repo is the site,
# not the notebook. LICENSE and NOTICE.md are the exceptions, they are the licence and the
# attribution the build is required to carry.
DELETE-BEFORE-PUSH*
notes/
scratch/
TODO.md
MAPS.md
*-spec.md
*-notes.md

# Local tooling and test harnesses. They generate what ships; they are not what ships.
tools/
*.local
*.local.*
CLAUDE.md
AGENTS.md
.claude/
.codex/
